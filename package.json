{
  "name": "kochabend-app",
  "version": "0.1.0",
  "private": true,
  "description": "Kochabend-Tagebuch für drei Paare",
  "type": "module",
  "scripts": {
    "start": "node scripts/dev.js",
    "worker": "npx wrangler dev --config worker/wrangler.toml --local --port 8787",
    "check-secrets": "node scripts/check-secrets.js",
    "deploy-worker": "npx wrangler deploy --config worker/wrangler.toml"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "workerd@1.20261113.1": true,
    "esbuild@0.28.2": true
  }
}
